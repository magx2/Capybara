from /capy/collection/CollectionTypes import { * }
from /capy/lang/Option import { * }
from /capy/lang/Ordering import { * }
from /capy/lang/Result import { * }
from /capy/lang/String import { * }
from PrimitiveBackedTypesBackingExtensions import { * }

type user_id -> int with constructor {
    if value > 0
    then Success { value }
    else Error { message: "bad user id" }
}

type order_id -> int
type score -> int
type token -> String
type ordered_string -> String
type proxied_byte -> byte
type proxied_int -> int
type proxied_long -> long
type custom_long -> long
type proxied_float -> float
type proxied_double -> double
type triple -> String with constructor {
    if value.size() == 3
    then Success { value }
    else Error { kind: "capy.lang.argument.invalid", message: "triple must contain exactly three characters" }
}

const FIRST_USER_ID = user_id! { 1 }

fun new_user_id(value: int): Result[user_id] = user_id { value }
fun raw_user_id(value: int): user_id = user_id! { value }
fun unwrap_user_id(id: user_id): int = id.value
fun unwrap_raw_user_id(value: int): int = unwrap_user_id(raw_user_id(value))
fun score_of(value: int): score = score { value }
fun unwrap_score(score: score): int = score.value
fun raw_token(value: String): token = token { value }
fun unwrap_token(value: token): String = value.value
fun append_token_suffix(value: String): String = value + "_suffix"
fun pass_token_to_string(value: token): String = append_token_suffix(value)
fun token.compare(other: token): bool = this.value == other.value
fun tokens_match(left: token, right: token): bool = left.compare(right)
fun ordered_string_compares_equal(value: ordered_string, other: String): bool = value.compare(other) == EQUAL

fun triple.to_upper_case(): String = "TRIPLE"
fun triple.triple(): triple = triple! { "abc" }
fun uppercase_triple(value: triple): String = value.to_upper_case()
fun replace_triple(value: triple): triple = value.triple()
fun append_to_triple(value: triple, suffix: String): String = value + suffix
fun plus_triple(value: triple, suffix: String): String = value.plus(suffix)
fun label_triple_with_external_backing_method(value: triple): String = value.backing_proxy_label()

fun proxied_long_to_int(value: proxied_long): int = value.to_int()
fun custom_long.to_int(): int = 99
fun custom_long_to_int(value: custom_long): int = value.to_int()
fun proxied_float_to_int(value: proxied_float): int = value.to_int()
fun proxied_double_to_int(value: proxied_double): int = value.to_int()
fun proxied_float_to_long(value: proxied_float): long = value.to_long()
fun proxied_double_to_long(value: proxied_double): long = value.to_long()

fun add_to_proxied_byte(value: proxied_byte): byte = value + 0x02
fun add_to_proxied_int(value: proxied_int): int = value + 2
fun add_to_proxied_long(value: proxied_long): long = value + 2L
fun add_to_proxied_float(value: proxied_float): float = value + 2.0f
fun add_to_proxied_double(value: proxied_double): double = value + 2.0

fun user_id.plus(other: user_id): user_id = user_id! { this.value + other.value }
fun user_id.`+`(other: user_id): user_id = user_id! { this.value + other.value }

fun plus_user_ids(left: user_id, right: user_id): user_id = left.plus(right)
fun add_user_ids(left: user_id, right: user_id): user_id = left + right

fun increment_int(value: int): int = value + 1
fun increment_user_id(id: user_id): int = increment_int(id)

fun string_at(input: String, idx: index): String =
    match input[idx] with
    case Some { value } -> value
    case None -> ""

fun string_get(input: String, idx: index): String =
    match input.get(idx) with
    case Some { value } -> value
    case None -> ""
