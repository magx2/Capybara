from /capy/test/Assert import { * }
from /capy/test/CapyTest import { * }
from /capy/lang/Effect import { * }
from /dev/capylang/test/hyphen-package/HyphenatedObject import { HyphenatedObject }

fun tests(): Effect[TestFile] =
    test_file("/dev/capylang/test/hyphen-package/HyphenatedObject.coo", [
        constructs_an_object_from_a_hyphenated_package().map(assertion =>
            test("constructs an object from a hyphenated package", () => assertion)
        ),
    ])

private fun constructs_an_object_from_a_hyphenated_package(): Effect[Assert] =
    let object <- HyphenatedObject()
    assert_that(true).is_true()
